{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HyperMD",
  "version": "0.1.0",
  "identifier": "dev.hypermd.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sem título.md — HyperMD",
        "width": 1100,
        "height": 760,
        "minWidth": 620,
        "minHeight": 420,
        "center": true,
        "decorations": false,
        "backgroundColor": "#171717"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost https: http:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
